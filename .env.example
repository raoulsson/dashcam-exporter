# dashcam-exporter — personal settings
#
# Copy this file to `.env` (which is gitignored) and fill in your own values.
# These are kept OUT of config.txt on purpose: config.txt is committed, and your
# home location should not be. A real environment variable of the same name
# overrides the value here.
#
# HOME LOCATION (optional but recommended).
# If set, the car parking within SET_HOME_RADIUS_M metres of this point is a
# hard trip boundary: arriving home ends a trip, and the next departure from
# home starts a new one — even when the trip's own GPS anchor is unreliable
# (e.g. loop-recording overwrote the departure, so the footage starts already
# out on the road). Grab the coordinates from Google Maps: right-click your
# home -> the first line of the menu is "lat, lon"; paste them here.
#
# The values below are a PLACEHOLDER (roughly central Metro Manila) — replace
# them with your own.
SET_HOME_LAT=14.5000
SET_HOME_LON=121.0000

# Radius in metres counted as "at home". Default 100 if unset.
SET_HOME_RADIUS_M=100

# ---------------------------------------------------------------------------
# PUBLISHING — only if you upload to S3 and deploy to a website.
#
# These name YOUR bucket, YOUR site checkout and YOUR live URL. They are as
# personal as the coordinates above, which is why they live here and not in
# config.txt: config.txt is tracked, so a value put there gets committed and
# pushed. Leave them unset and the CLI is import -> render -> local page; the
# upload and deploy steps grey out with a reason instead of disappearing.
#
# A real environment variable of the same name overrides this file.
# ---------------------------------------------------------------------------
#SET_SITE_REPO=~/dev/your-site
#SET_S3_BUCKET=your-media-bucket
#SET_S3_REGION=eu-central-1
#SET_LIVE_TRIPS_URL=https://example.com/your-site/trips.json
